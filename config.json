{
    "permanent_storage": {
        "location": "s3",
        "bucket": "mindmodel"
    },
    "paths": {
        "root": "/root/mdb_storage"
    },
    "auth":{
        "http_auth_enabled": true
    },
    "api": {
        "http": {
            "host": "0.0.0.0",
            "port": "47334"
        },
        "mysql": {
            "host": "0.0.0.0",
            "port": "47335",
            "database": "mindsdb",
            "ssl": true
        }
    },
    "cache": {
        "type": "local"
    },
    "logging": {
        "handlers": {
            "console": {
                "enabled": true,
                "formatter": "default",
                "level": "INFO"
            },
            "file": {
                "enabled": true,
                "level": "INFO",
                "filename": "mindsdb.log",
                "maxBytes": 10485760,
                "backupCount": 5
            }
        }
    }
}